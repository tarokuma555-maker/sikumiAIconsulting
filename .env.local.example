# ※ Supabaseの設定はフォーム廃止に伴い不要になりました
# サイトURL / LINE公式アカウントのURL
#   通常は site.config.json に書いてあるので、ここは設定不要です。
#   一時的に別のURLで動かしたいときだけ、ここで上書きできます。
# NEXT_PUBLIC_SITE_URL=
# NEXT_PUBLIC_LINE_URL=

# LINE Messaging API
#   LINE Developers > 対象チャネル > Messaging API設定 から取得します。
#   - LINE_CHANNEL_SECRET       : 「チャネル基本設定」のチャネルシークレット
#   - LINE_CHANNEL_ACCESS_TOKEN : 「Messaging API設定」の長期チャネルアクセストークン
#   どちらも秘密情報です。Vercelの環境変数に入れ、リポジトリには書かないでください。
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
