# Supabase(未設定でもフォームはエラーにならず、サーバーログに出力されます)
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# LINE公式アカウントの友だち追加URL
#   例: https://lin.ee/xxxxxxx  /  https://line.me/R/ti/p/@xxxxx
# 設定すると、無料相談の送信後にこのURLへ自動遷移し、
# ヒーローと申込フォーム横のLINE導線も表示されます。
# 未設定の場合、LINE導線は表示されません(リンク切れを出さないため)。
NEXT_PUBLIC_LINE_URL=

# 公開サイトのURL(LINEのメッセージからLPへリンクするときに使用)
NEXT_PUBLIC_SITE_URL=https://example.com

# LINE Messaging API
#   LINE Developers > 対象チャネル > Messaging API設定 から取得します。
#   - LINE_CHANNEL_SECRET       : 「チャネル基本設定」のチャネルシークレット
#   - LINE_CHANNEL_ACCESS_TOKEN : 「Messaging API設定」の長期チャネルアクセストークン
#   どちらも秘密情報です。Vercelの環境変数に入れ、リポジトリには書かないでください。
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
